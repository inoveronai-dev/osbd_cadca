# Admin login (same password for all listed emails)
ADMIN_EMAIL=admin@example.com
# Optional extra emails, comma-separated (same ADMIN_PASSWORD_HASH)
ADMIN_EMAILS=admin@example.com,kablovka@osbdcadca.sk
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# Escape every $ as \$ — Next dotenv expands bare $ in $2b$12$...
ADMIN_PASSWORD_HASH=\$2b\$12\$replace_with_your_hash
# Min 32 random characters
SESSION_SECRET=

# GitHub CMS
GITHUB_TOKEN=
GITHUB_REPO=inoveronai-dev/osbd_cadca
# Production admin writes to main (triggers live redeploy)
GITHUB_BRANCH=main
