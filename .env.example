# Single admin account
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=
# Min 32 random characters
SESSION_SECRET=

# GitHub CMS
GITHUB_TOKEN=
GITHUB_REPO=inoveronai-dev/osbd_cadca
# Production admin writes to main (triggers live redeploy)
GITHUB_BRANCH=main
